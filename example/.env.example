# Copy to `.env` to run the example: `cp example/.env.example example/.env`
#
# Without a password the dashboard answers 404 by design — it does not exist as
# far as the network is concerned — so `pnpm dev` alone leaves /_monitor looking
# broken rather than protected. These two lines are the difference.

# Read at build time by `monitor.auth.password` in nuxt.config.ts.
MONITOR_PASSWORD=demo

# Read when the server starts, so a build made without a password still opens.
NUXT_MONITOR_AUTH_PASSWORD=demo

# Stamped on every event as the release facet.
NUXT_MONITOR_RELEASE=dev
